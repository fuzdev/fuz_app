{
  "name": "@fuzdev/fuz_app",
  "version": "0.152.0",
  "description": "fullstack app library",
  "glyph": "🗝",
  "logo": "logo.svg",
  "logo_alt": "a friendly teal spider facing you",
  "license": "0BSD",
  "homepage": "https://app.fuz.dev/",
  "repository": "https://github.com/fuzdev/fuz_app",
  "scripts": {
    "start": "gro dev",
    "dev": "gro dev",
    "build": "gro build",
    "check": "gro check",
    "test": "gro test",
    "test:cross": "node --conditions=development src/test/cross_backend/run_cross.ts",
    "test:cross:ts": "FUZ_TEST_CROSS_BACKEND=1 vitest run --project cross_backend_ts_node --project cross_backend_ts_deno --project cross_backend_ts_bun",
    "test:cross:rust-spine-stub": "FUZ_TEST_CROSS_BACKEND=1 vitest run --project cross_backend_rust_spine_stub",
    "test:cross:parity": "FUZ_TEST_CROSS_BACKEND=1 vitest run --project cross_backend_parity",
    "test:cross:security": "FUZ_TEST_CROSS_BACKEND=1 vitest run --project cross_backend_security",
    "test:cross:timing": "FUZ_TEST_CROSS_BACKEND=1 vitest run --project cross_backend_timing",
    "test:cross:ts-differential": "FUZ_TEST_CROSS_BACKEND=1 vitest run --project cross_backend_ts_differential",
    "benchmark:cross-impl": "gro run src/benchmarks/cross_impl.bench.ts",
    "preview": "vite preview",
    "deploy": "gro deploy"
  },
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#routes/*": "./src/routes/*"
  },
  "engines": {
    "node": ">=24.14"
  },
  "peerDependencies": {
    "@electric-sql/pglite": ">=0.4",
    "@fuzdev/blake3-wasm": ">=0.2.0",
    "@fuzdev/fuz_css": ">=0.72.0",
    "@fuzdev/fuz_schema": "^0.5.0",
    "@fuzdev/fuz_util": ">=0.79.0",
    "@fuzdev/pglet-wasm": ">=0.1.2",
    "@hono/bun": ">=1",
    "@hono/deno": ">=1",
    "@hono/node-server": ">=1",
    "@hono/node-ws": ">=1",
    "@node-rs/argon2": ">=2",
    "@sveltejs/kit": "^3",
    "esm-env": "^1",
    "hono": ">=4",
    "pg": ">=8",
    "svelte": "^5",
    "ws": ">=8",
    "zod": "^4"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    },
    "@fuzdev/fuz_css": {
      "optional": true
    },
    "@fuzdev/pglet-wasm": {
      "optional": true
    },
    "@hono/bun": {
      "optional": true
    },
    "@hono/deno": {
      "optional": true
    },
    "@hono/node-server": {
      "optional": true
    },
    "@hono/node-ws": {
      "optional": true
    },
    "@node-rs/argon2": {
      "optional": true
    },
    "esm-env": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fuzdev/blake3-wasm": "^0.2.0",
    "@fuzdev/fuz_code": "^0.56.0",
    "@fuzdev/fuz_css": "^0.72.0",
    "@fuzdev/fuz_schema": "^0.5.0",
    "@fuzdev/fuz_ui": "^0.221.0",
    "@fuzdev/fuz_util": "^0.79.0",
    "@fuzdev/gro": "^0.223.0",
    "@fuzdev/mdz": "^0.7.0",
    "@fuzdev/pglet-wasm": "^0.1.2",
    "@hono/bun": "^1.0.1",
    "@hono/deno": "^1.0.3",
    "@hono/node-server": "^1.19.14",
    "@hono/node-ws": "^1.3.1",
    "@node-rs/argon2": "^2.0.2",
    "@ryanatkn/eslint-config": "^0.13.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/package": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/estree": "^1.0.8",
    "@types/pg": "^8.18.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.4",
    "eslint-plugin-svelte": "^3.15.1",
    "esm-env": "^1.2.2",
    "hono": "^4.13.9",
    "jsdom": "^28.1.0",
    "pg": "^8.20.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-docinfo": "^0.17.0",
    "svelte2tsx": "^0.7.52",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.0",
    "ws": "^8.20.1",
    "zod": "^4.6.7"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.ts": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.svelte": {
      "types": "./dist/*.svelte.d.ts",
      "svelte": "./dist/*.svelte",
      "default": "./dist/*.svelte"
    },
    "./*.json": {
      "types": "./dist/*.json.d.ts",
      "default": "./dist/*.json"
    }
  }
}
